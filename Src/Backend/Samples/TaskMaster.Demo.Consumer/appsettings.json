{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },

  "ConnectionStrings": {
    "DefaultConnection": ""
  },

  "Database": {
    "Provider": "SqlServer"
  },

  "Storage": {
    "Provider": "Local",
    "RootPath": "./storage/reports",
    "MaxFileBytes": 8388608
  },

  "TaskMaster": {
    "ApiBaseUrl": "https://localhost:7143/",
    "Oidc": {
      "ClientId": "",
      "ClientSecret": ""
    }
  },

  "Demo": {
    "MaxRecords": 10000,
    "MaxResultBytes": 1048576,
    "MaxExecutionSeconds": 120,
    "RowDelayMilliseconds": 2,
    "MaxConcurrentHandlers": 4,
    "WorkerName": "demo-report-worker",
    "StaleReportTimeoutMinutes": 10,
    "StaleSweepMinutes": 5
  }
}

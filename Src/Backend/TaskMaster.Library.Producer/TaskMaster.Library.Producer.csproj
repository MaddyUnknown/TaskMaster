<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<IsPackable>true</IsPackable>
	<PackageId>TaskMaster.Library.Producer</PackageId>
	<Description>TaskMaster Producer SDK - Create worker and consumer job from Taskmaster CoordinatorAPI</Description>
	<PackageTags>taskmaster;producer;library;sdk</PackageTags>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.8" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Newtonsoft.Json.Schema" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TaskMaster.Library.Common\TaskMaster.Library.Common.csproj" />
  </ItemGroup>

</Project>
